{
  "name": "prime-client",
  "version": "0.1.0",
  "private": true,
  "description": "Prime - a fast, no-nonsense Minecraft Java launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:node && wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "release:minor": "node tools/release.mjs --minor",
    "release:major": "node tools/release.mjs --major"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
